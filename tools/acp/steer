#!/bin/zsh
# steer — your direct line to Bob while the orchestrator runs.
#
#   ./steer watch              live view of Bob (events + prose), Ctrl-C to leave
#   ./steer allow              approve the pending permission
#   ./steer always             approve + auto-approve this tool from now on (policy)
#   ./steer reject             reject the pending permission
#   ./steer stop               cancel the running turn (session survives)
#   ./steer "do X instead"     cancel + redirect Bob with your message (same session)
#   ./steer status             one-line state: phase, pending permission, session
#   LANE=<name> ./steer ...    act on run/<name>/ instead of run/
cd "$(dirname "$0")"
RUN=run${LANE:+/$LANE}   # LANE=<name> ./steer ... targets run/<name>/
case "$1" in
  watch)  exec tail -n 20 -f $RUN/live.log $RUN/agent-text.log ;;
  allow)  echo '{"cmd":"allow"}' >> $RUN/control.jsonl; echo answered: allow ;;
  always)
    T=$(python3 -c "import json;s=json.load(open('$RUN/state.json'));p=s['pendingPermission'];print(p['title'] if p else '')")
    [ -z "$T" ] && { echo "no pending permission"; exit 1; }
    python3 -c "
import json,os
f='$RUN/policy.json'
rules=json.load(open(f)) if os.path.exists(f) else []
rules.append({'match':'''$T''','decision':'allow'})
json.dump(rules,open(f,'w'),indent=1)"
    echo '{"cmd":"allow"}' >> $RUN/control.jsonl; echo "answered allow + policy rule saved: $T" ;;
  reject) echo '{"cmd":"reject"}' >> $RUN/control.jsonl; echo answered: reject ;;
  stop)   echo '{"cmd":"cancel"}' >> $RUN/control.jsonl; echo cancel sent ;;
  status) python3 -c "
import json;s=json.load(open('$RUN/state.json'))
p=s['pendingPermission']
print(f\"phase={s['phase']} stop={s['stopReason']} session={s['sessionId']} pending={p['title'] if p else '-'}\")" ;;
  "")     echo "usage: ./steer watch|allow|always|reject|stop|status|\"redirect message\""; exit 1 ;;
  *)      # free text = cancel current turn (if running) and redirect Bob on the same session
    SID=$(python3 -c "import json;print(json.load(open('$RUN/state.json'))['sessionId'])")
    PHASE=$(python3 -c "import json;print(json.load(open('$RUN/state.json'))['phase'])")
    if [ "$PHASE" = "running" ]; then echo '{"cmd":"cancel"}' >> $RUN/control.jsonl; sleep 2; fi
    echo "redirecting Bob (session $SID): $1"
    nohup node turn.mjs ${LANE:+--lane "$LANE"} --resume "$SID" "$1" >> $RUN/turns.out 2>&1 &
    echo "watch with: ./steer watch" ;;
esac
